{
  "manifest_version": 3,
  "name": "Nano SEO Lab",
  "version": "0.8.4",
  "description": "Research harness for testing Chrome Gemini Nano against Gemini/OpenAI on browser-native SEO tasks.",
  "minimum_chrome_version": "138",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Nano SEO Lab"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
